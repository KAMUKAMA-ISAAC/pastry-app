# Single .env for the whole app (Render: paste these into the service's
# Environment tab — Render doesn't read a committed .env file).
# The frontend is built into the same image and calls relative /api/* URLs,
# so it needs no separate env vars or origin at build time.

# --- Database (required) ---
MONGO_URL=mongodb://user:pass@host/db
DB_NAME=pastry_quin

# --- Auth (required) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- CORS / links back to the frontend (used for CORS origin + email links) ---
# Set this to your Render service's public URL once you have it, e.g.
# https://pastry-quin.onrender.com
FRONTEND_URL=https://your-app.onrender.com

# --- Admin bootstrap account (optional, defaults shown are hardcoded fallbacks) ---
ADMIN_EMAIL=quinpastry@gmail.com
ADMIN_PASSWORD=change-me

# --- Emergent integrations (file storage + email + LLM) ---
INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
EMERGENT_LLM_KEY=
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=PASTRY QUIN
EMAIL_REPLY_TO=

# --- Cron/webhook auth (optional; leave blank to disable secret check) ---
WEBHOOK_CRON_SECRET=

# --- Server (Render sets this automatically; harmless to leave as-is) ---
PORT=8000
