# Backend API env (Render: paste these into the service's Environment tab —
# Render doesn't read a committed .env file). The frontend is deployed
# separately on Vercel — see frontend/.env.example for its env vars.

# --- Database (required) ---
# A Postgres connection string (e.g. from Neon). Include sslmode=require.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Auth (required) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- CORS / links back to the frontend (used for CORS origin + email links) ---
# The frontend's public URL (Vercel).
FRONTEND_URL=https://pastry-quin-eosin.vercel.app

# --- Admin bootstrap account (optional, defaults shown are hardcoded fallbacks) ---
ADMIN_EMAIL=quinpastry@gmail.com
ADMIN_PASSWORD=change-me

# --- Emergent integrations (file storage + email + LLM) ---
INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
EMERGENT_LLM_KEY=
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=PASTRY QUIN
EMAIL_REPLY_TO=

# --- Cron/webhook auth (optional; leave blank to disable secret check) ---
WEBHOOK_CRON_SECRET=

# --- Server (Render sets this automatically; harmless to leave as-is) ---
PORT=8000
